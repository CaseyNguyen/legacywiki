# Copy to .env.local for local runs. On a host (Render etc.), set these in its environment settings.

# Enables AI-written team stories (one Claude call per team, stored forever).
# Without it, every team gets a summary built from its stats.
ANTHROPIC_API_KEY=

# Model used for team stories.
LEGACYWIKI_STORY_MODEL=claude-sonnet-5-5

# Spending limits for the key. When one is reached, pages show the stats summary
# and the article is written on a later visit once the limit resets. 0 turns a limit off.
LEGACYWIKI_AI_DAILY_CALL_LIMIT=50
LEGACYWIKI_AI_MONTHLY_CALL_LIMIT=300
LEGACYWIKI_AI_MONTHLY_TOKEN_LIMIT=1500000
# Time zone for the daily/monthly reset.
LEGACYWIKI_TIMEZONE=America/Los_Angeles

# Where cached Sleeper data, player data, palettes, stories, league models and AI usage live.
# Defaults to ./.legacywiki-cache. On Render, point it at the persistent disk (/data).
LEGACYWIKI_CACHE_DIR=

# Optional: override the Sleeper API base URL (useful for testing against a mock).
SLEEPER_API_BASE=https://api.sleeper.app/v1
